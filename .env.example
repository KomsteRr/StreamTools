# ─── Required ────────────────────────────────────────────────────
SESSION_SECRET=your-256-bit-random-here        # Required: used for HMAC-SHA256 session cookies
ADMIN_PASSWORD=your-admin-password-here        # Required: source of truth for the admin login
COOKIE_SECURE=false                            # Set true only when the app is served over HTTPS without a TLS proxy
DATABASE_URL="file:/data/prod.db"              # Required: persistent SQLite database in Docker

# ─── Spotify (optional) ────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# ─── Optional ──────────────────────────────────────────────────
# NODE_ENV=development
