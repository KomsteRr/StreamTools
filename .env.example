# ─── Required ────────────────────────────────────────────────────
SESSION_SECRET=your-256-bit-random-here        # Required: used for HMAC-SHA256 session cookies
ADMIN_PASSWORD=your-admin-password-here        # Required: admin login (stored as bcrypt hash on first login)

# ─── Spotify (optional) ────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"                   # SQLite (default)
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"  # PostgreSQL

# ─── Optional ──────────────────────────────────────────────────
# NODE_ENV=development
