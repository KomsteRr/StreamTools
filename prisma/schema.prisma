// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Invites ─────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String?            // null until invite is completed
  role         String   @default("user") // "admin" | "user"
  createdAt    DateTime @default(now())

  spotifyTokens   SpotifyToken[]
  spotifyConfigs  SpotifyConfig[]
  platformConfigs PlatformConfig[]
  alertConfigs    AlertConfig[]
  inviteTokens    InviteToken[]
}

model InviteToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

// ─── Spotify ─────────────────────────────────────────────────────────────────

model SpotifyToken {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SpotifyConfig {
  id    String @id @default(cuid())
  key   String
  value String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
}

// ─── Platform Configs ────────────────────────────────────────────────────────

model PlatformConfig {
  id       String @id @default(cuid())
  platform String // twitch | youtube | kick | system | spotify
  key      String
  value    String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, key, userId])
}

// ─── Alert Configs ───────────────────────────────────────────────────────────

model AlertConfig {
  id       String @id @default(cuid())
  type     String // follow | sub | bits | raid | cheer | gift_sub
  platform String @default("twitch") // twitch | youtube | kick

  enabled  Boolean @default(true)
  soundUrl String?
  imageUrl String?

  // Full-screen background media
  bgMediaUrl  String?
  bgMediaType String? // image | gif | video

  // Text & typography
  text      String @default("{user}")
  textColor String @default("#ffffff")
  fontSize  Int    @default(28)

  // Glow / shadow effect on text
  glowColor String @default("#6441a5")
  glowSize  Int    @default(0)

  // Alert box border
  borderColor String @default("#ffffff")
  borderWidth Int    @default(0)

  // Timing & sound
  duration Int   @default(5)
  volume   Float @default(0.8)

  // Background
  bgColor          String @default("#6441a5")
  bgOverlayOpacity Float  @default(0.4)

  // Position on screen
  position String @default("center")

  // Animations
  animation     String @default("slide-in")
  exitAnimation String @default("fade")

  // Container image
  containerImageUrl String?
  containerWidth    Int     @default(400)
  containerHeight   Int     @default(200)

  // Container layout
  containerLayout String @default("column")
  textAlign       String @default("center")
  imageSize       Int    @default(80)

  // Font family (Google Font name)
  fontFamily String @default("Inter")

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, platform, userId])
}
